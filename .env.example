# Variáveis de ambiente — copie este arquivo para .env e ajuste os valores
# NUNCA commite o arquivo .env no Git

# Usuário do banco de dados
DB_USER=edulanches

# Senha do banco — TROQUE ANTES DE IMPLANTAR EM PRODUÇÃO
DB_PASSWORD=troque_esta_senha

# Nome do banco de dados
DB_NAME=edulanches

# URL de conexão completa (montada automaticamente no docker-compose.yml)
# Para testes locais sem Docker, preencha com seu servidor PostgreSQL:
DATABASE_URL=postgres://edulanches:troque_esta_senha@localhost:5432/edulanches

# Porta da aplicação
PORT=3000

# Versão da aplicação (exibida no log de inicialização)
APP_VERSION=1.0.0
